# ============================================================
# EDULINK — environment template (copy to .env / Vercel / Render)
# ============================================================

# ---- Vercel (web/.env.local) ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
NEXT_PUBLIC_APP_URL=https://k2020.org.za

# ---- Supabase Edge Functions (Supabase dashboard -> Functions -> Secrets) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # NEVER expose to the browser
PAYFAST_MERCHANT_ID=10012345
PAYFAST_MERCHANT_KEY=<merchant-key>
PAYFAST_PASSPHRASE=<secure-passphrase>
PAYFAST_SANDBOX=true
PAYFAST_NOTIFY_URL=https://<project-ref>.supabase.co/functions/v1/payfast-billing-webhook
ONESIGNAL_APP_ID=<app-id>
ONESIGNAL_REST_API_KEY=<rest-api-key>
EDULINK_CRON_SECRET=<long-random-string>       # shared with render.yaml

# ---- Render cron services ----
# EDULINK_SUPABASE_URL
# EDULINK_SERVICE_ROLE_KEY
# EDULINK_CRON_SECRET
